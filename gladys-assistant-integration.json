{
  "manifest_version": 1,
  "type": "device",
  "name": "HomeKit Controller",
  "description": {
    "en": "Pair and control your HomeKit Wi-Fi/Ethernet accessories from Gladys, no Apple hub needed.",
    "fr": "Appairez et pilotez vos accessoires HomeKit Wi-Fi/Ethernet depuis Gladys, sans hub Apple."
  },
  "version": "1.0.3",
  "docker_image": "ghcr.io/prohand/gladys-homekitcontroller:1.0.3",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-homekitcontroller/main/cover.png",
  "categories": ["protocols", "lighting", "climate"],
  "transports": ["local"],
  "network_discovery": [
    {
      "type": "mdns",
      "service": "_hap._tcp"
    }
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer"
      },
      "description": {
        "en": "1. Remove the accessory from Apple Home (a HomeKit accessory accepts only one controller). 2. Click \"Search for accessories\" below. 3. Click \"Pair an accessory\" with its name and the 8-digit setup code printed on it. 4. Add its devices from the Discovery tab.",
        "fr": "1. Retirez l'accessoire de l'app Maison d'Apple (un accessoire HomeKit n'accepte qu'un seul contrôleur). 2. Cliquez sur « Rechercher les accessoires » ci-dessous. 3. Cliquez sur « Appairer un accessoire » avec son nom et le code à 8 chiffres imprimé dessus. 4. Ajoutez ses appareils depuis l'onglet Découverte."
      },
      "links": [
        {
          "url": "https://github.com/prohand/gladys-homekitcontroller",
          "label": {
            "en": "Integration page",
            "fr": "Page de l'intégration"
          }
        }
      ]
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de rafraîchissement (s)"
      },
      "description": {
        "en": "HomeKit pushes changes in real time; this full refresh is only a safety net.",
        "fr": "HomeKit envoie les changements en temps réel ; ce rafraîchissement complet n'est qu'une sécurité."
      },
      "required": false,
      "default": 60,
      "min": 10,
      "max": 3600
    },
    {
      "key": "scan_timeout",
      "type": "number",
      "label": {
        "en": "Search duration (s)",
        "fr": "Durée de recherche (s)"
      },
      "description": {
        "en": "How long Gladys listens for HomeKit accessories on the network.",
        "fr": "Durée pendant laquelle Gladys écoute les accessoires HomeKit sur le réseau."
      },
      "required": false,
      "default": 10,
      "min": 3,
      "max": 30
    }
  ],
  "actions": [
    {
      "key": "list_accessories",
      "label": {
        "en": "Search for accessories",
        "fr": "Rechercher les accessoires"
      },
      "timeout_seconds": 45
    },
    {
      "key": "pair",
      "label": {
        "en": "Pair an accessory",
        "fr": "Appairer un accessoire"
      },
      "timeout_seconds": 120,
      "fields": [
        {
          "key": "accessory",
          "type": "string",
          "label": {
            "en": "Accessory",
            "fr": "Accessoire"
          },
          "description": {
            "en": "Name, HomeKit ID or IP address shown by the search, or IP:port.",
            "fr": "Nom, identifiant HomeKit ou adresse IP affichés par la recherche, ou IP:port."
          },
          "required": true
        },
        {
          "key": "setup_code",
          "type": "string",
          "label": {
            "en": "Setup code",
            "fr": "Code de configuration"
          },
          "placeholder": {
            "en": "123-45-678",
            "fr": "123-45-678"
          },
          "required": true
        }
      ]
    },
    {
      "key": "identify",
      "label": {
        "en": "Identify a device",
        "fr": "Identifier un appareil"
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Device",
            "fr": "Appareil"
          },
          "required": true
        }
      ]
    },
    {
      "key": "unpair",
      "label": {
        "en": "Unpair an accessory",
        "fr": "Désappairer un accessoire"
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Device",
            "fr": "Appareil"
          },
          "description": {
            "en": "The whole accessory is unpaired (every device of a bridge).",
            "fr": "Tout l'accessoire est désappairé (tous les appareils d'un pont)."
          },
          "required": true
        }
      ]
    }
  ],
  "scene_triggers": [
    {
      "key": "button_pressed",
      "label": {
        "en": "HomeKit button pressed",
        "fr": "Bouton HomeKit appuyé"
      },
      "description": {
        "en": "A HomeKit button or doorbell was pressed.",
        "fr": "Un bouton ou une sonnette HomeKit a été appuyé."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Device",
            "fr": "Appareil"
          },
          "description": {
            "en": "Leave empty for any button.",
            "fr": "Laisser vide pour n'importe quel bouton."
          },
          "required": false
        },
        {
          "key": "press",
          "type": "multi_select",
          "label": {
            "en": "Press",
            "fr": "Appui"
          },
          "description": {
            "en": "Leave empty for any press.",
            "fr": "Laisser vide pour n'importe quel appui."
          },
          "options": [
            {
              "value": "single",
              "label": {
                "en": "Single press",
                "fr": "Appui simple"
              }
            },
            {
              "value": "double",
              "label": {
                "en": "Double press",
                "fr": "Double appui"
              }
            },
            {
              "value": "long",
              "label": {
                "en": "Long press",
                "fr": "Appui long"
              }
            }
          ],
          "required": false
        },
        {
          "key": "button_index",
          "type": "number",
          "label": {
            "en": "Button number",
            "fr": "Numéro du bouton"
          },
          "description": {
            "en": "For an accessory with several buttons. Leave empty for any.",
            "fr": "Pour un accessoire à plusieurs boutons. Laisser vide pour tous."
          },
          "min": 1,
          "max": 99,
          "required": false
        }
      ],
      "variables": [
        {
          "key": "accessory",
          "type": "string",
          "label": {
            "en": "Accessory",
            "fr": "Accessoire"
          }
        },
        {
          "key": "button",
          "type": "string",
          "label": {
            "en": "Button",
            "fr": "Bouton"
          }
        },
        {
          "key": "button_index",
          "type": "number",
          "label": {
            "en": "Button number",
            "fr": "Numéro du bouton"
          }
        },
        {
          "key": "press",
          "type": "string",
          "label": {
            "en": "Press (single, double, long)",
            "fr": "Appui (single, double, long)"
          }
        },
        {
          "key": "doorbell",
          "type": "boolean",
          "label": {
            "en": "Doorbell",
            "fr": "Sonnette"
          }
        }
      ]
    },
    {
      "key": "accessory_status",
      "label": {
        "en": "HomeKit accessory offline / back",
        "fr": "Accessoire HomeKit perdu / revenu"
      },
      "description": {
        "en": "A HomeKit accessory became unreachable or came back.",
        "fr": "Un accessoire HomeKit est devenu injoignable ou est revenu."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Device",
            "fr": "Appareil"
          },
          "description": {
            "en": "Leave empty for any accessory.",
            "fr": "Laisser vide pour n'importe quel accessoire."
          },
          "required": false
        },
        {
          "key": "status",
          "type": "select",
          "label": {
            "en": "Status",
            "fr": "État"
          },
          "options": [
            {
              "value": "offline",
              "label": {
                "en": "Offline",
                "fr": "Hors ligne"
              }
            },
            {
              "value": "online",
              "label": {
                "en": "Back online",
                "fr": "De retour"
              }
            }
          ],
          "required": false
        }
      ],
      "variables": [
        {
          "key": "accessory",
          "type": "string",
          "label": {
            "en": "Accessory",
            "fr": "Accessoire"
          }
        },
        {
          "key": "status",
          "type": "string",
          "label": {
            "en": "Status (offline, online)",
            "fr": "État (offline, online)"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "identify",
      "label": {
        "en": "Identify a HomeKit device",
        "fr": "Identifier un appareil HomeKit"
      },
      "description": {
        "en": "The accessory signals itself (blinks, beeps…).",
        "fr": "L'accessoire se signale (clignote, émet un son…)."
      },
      "timeout_seconds": 20,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Device",
            "fr": "Appareil"
          },
          "required": true
        }
      ]
    },
    {
      "key": "refresh",
      "label": {
        "en": "Re-read a HomeKit device",
        "fr": "Relire un appareil HomeKit"
      },
      "description": {
        "en": "Read every value of the accessory now.",
        "fr": "Relit tout de suite toutes les valeurs de l'accessoire."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Device",
            "fr": "Appareil"
          },
          "required": true
        }
      ]
    }
  ],
  "widgets": [
    {
      "key": "accessories",
      "label": {
        "en": "HomeKit accessories",
        "fr": "Accessoires HomeKit"
      },
      "description": {
        "en": "Online / offline paired accessories, with a reconnect button.",
        "fr": "Accessoires appairés en ligne / hors ligne, avec un bouton pour reconnecter."
      },
      "icon": "home",
      "action_timeout_seconds": 45
    }
  ]
}
